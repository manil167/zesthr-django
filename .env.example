# Copy to .env for local work. Never commit .env. No real secrets in this file.
DJANGO_SETTINGS_MODULE=payroll_project.settings.development
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Production only (settings.production)
DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.example.com
# Either a single URL (Neon, Supabase, Render...) ...
DATABASE_URL=
# ... or the separate values:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Keep False when using Supabase's direct database connection.
# Set True only when deliberately using a connection pooler.
DB_POOLED=False
DB_CONNECT_TIMEOUT=10

DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=False


# Email (password reset). Production needs a real SMTP server.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=HROS <hr@example.com>

# Attendance
DJANGO_CORRECTION_WINDOW_DAYS=30

# Sessions and sign-in protection
DJANGO_SESSION_IDLE_MINUTES=60
DJANGO_PASSWORD_RESET_MINUTES=60
DJANGO_LOGIN_MAX_FAILURES=5
DJANGO_LOGIN_FAILURE_WINDOW_MINUTES=15
DJANGO_TRUST_X_FORWARDED_FOR=False

# Production security (see settings/production.py for explanations)
DJANGO_SSL_REDIRECT=True
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO

# Production uploads remain disabled until private durable storage is configured.
DJANGO_DOCUMENT_UPLOADS_ENABLED=False
DJANGO_PRIVATE_DOCUMENT_ROOT=


# Recommended production HR documents: dedicated private S3 bucket encrypted with KMS.
DJANGO_DOCUMENT_STORAGE=filesystem
DJANGO_DOCUMENT_BUCKET=
DJANGO_DOCUMENT_REGION=
DJANGO_DOCUMENT_KMS_KEY_ID=
# Supply AWS credentials through the hosting secret manager or an IAM role.
# Never use AWS root-account credentials or commit credentials.

# Neon managed Better Auth (optional locally; use the same branch as DATABASE_URL).
# Enable email verification and add the application origin in Neon's trusted origins.
NEON_AUTH_BASE_URL=
NEON_AUTH_APP_ORIGIN=http://localhost:8000
# Use a pooled Neon DATABASE_URL with sslmode=verify-full for hosted web traffic.
# See docs/NEON_AND_MESSAGING.md for provider and account migration instructions.

# WhatsApp Business Cloud API. Set real secret values securely, never in Git.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# Optional create-only admin bootstrap; set real credentials privately in Render.
# Requires NEON_AUTH_BASE_URL to be unset (Django login).
DJANGO_BOOTSTRAP_ADMIN=False
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# Disable bootstrap and remove the password after successful login.

# With Neon Auth: explicitly grant admin access to this exact verified Neon user.
# Copy the ID from Neon Console -> Auth -> Users (not the project/branch ID).
NEON_ADMIN_USER_ID=
NEON_ADMIN_EMAIL=
# Set DJANGO_BOOTSTRAP_ADMIN=True for the first verified sign-in, then disable it.
# Local DJANGO_SUPERUSER_PASSWORD is never a Neon password.

# HROS Assistant: credentials remain server-side and outside version control.
OPENAI_API_KEY=
DJANGO_ASSISTANT_ENABLED=False
DJANGO_ASSISTANT_MODEL=gpt-6-luna
DJANGO_ASSISTANT_MINUTE_LIMIT=10
DJANGO_ASSISTANT_DAILY_LIMIT=100
